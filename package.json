{
  "name": "nightowl",
  "version": "0.1.0",
  "description": "NightOwl is a local code review CLI built with the GitHub Copilot SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "README.md",
    "TESTING.md",
    "AGENTS.md"
  ],
  "bin": {
    "review": "./dist/bin/review.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "review": "node src/bin/review.ts",
    "test": "npm run build && node ./scripts/test-tier-runner.mjs all",
    "test:unit": "npm run build && node ./scripts/test-tier-runner.mjs unit",
    "test:integration": "npm run build && node ./scripts/test-tier-runner.mjs integration",
    "test:e2e": "npm run build && node ./scripts/test-tier-runner.mjs e2e",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.0-beta.8",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.8.0"
  }
}
